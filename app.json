{
  "expo": {
    "name": "uberclone",
    "slug": "uberclone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tus fotos para el registro del conductor.",
        "NSCameraUsageDescription": "Necesitamos la cámara para tomar fotos del registro del conductor."
      }
    },
    "android": {
      "package": "com.juanp.uberclone",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para el registro del conductor.",
          "cameraPermission": "Necesitamos la cámara para tomar fotos del registro del conductor."
        }
      ],
      "@react-native-firebase/app"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
