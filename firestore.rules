// AI-assisted: see docs/AI_LOG.md #33
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /drivers/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.accountStatus == 'pending';
      allow update: if isOwner(uid)
        && request.resource.data.accountStatus == resource.data.accountStatus;
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.driverId == request.auth.uid;
      allow delete: if false;
    }

    match /driverLocations/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn()
        && (resource.data.driverId == request.auth.uid
          || resource.data.passengerId == request.auth.uid
          || resource.data.driverId == null);
      allow update: if isSignedIn()
        && (resource.data.driverId == null
          || resource.data.driverId == request.auth.uid
          || request.resource.data.driverId == request.auth.uid);
      allow delete: if false;
    }

    match /devTriggers/{docId} {
      allow read: if isSignedIn();
      allow write: if true;
    }
  }
}
